# Self-signed certificate for the internal ALB. Generated by the tls provider,
# imported into ACM for the listener, and published to SSM so clients (the
# webhook Lambda) can pin it. Valid 365 days: renew before expiry by
# re-applying with `terraform apply -replace=tls_self_signed_cert.alb`.

resource "tls_private_key" "alb" {
  algorithm = "RSA"
  rsa_bits  = 2048
}

resource "tls_self_signed_cert" "alb" {
  private_key_pem = tls_private_key.alb.private_key_pem

  subject {
    common_name         = var.guardrails_domain_name
    organization        = "Netskope"
    organizational_unit = "AI Guardrails"
  }

  dns_names = [var.guardrails_domain_name]

  is_ca_certificate     = true
  validity_period_hours = 8760

  allowed_uses = [
    "digital_signature",
    "key_encipherment",
    "cert_signing",
    "server_auth",
  ]
}

resource "aws_acm_certificate" "alb" {
  private_key      = tls_private_key.alb.private_key_pem
  certificate_body = tls_self_signed_cert.alb.cert_pem

  tags = { Name = "${var.guardrails_name}-alb" }

  lifecycle {
    create_before_destroy = true
  }
}

resource "aws_ssm_parameter" "guardrails_cert" {
  name        = local.cert_parameter_name
  description = "Self-signed ALB certificate PEM for the AI Guardrails endpoint. Clients pin it."
  type        = "String"
  value       = tls_self_signed_cert.alb.cert_pem
}
