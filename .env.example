# ---------------------------------------------------------------------------
# Netskope AI Guardrails on Demand + Anthropic Inference hooks webhook.
# Copy this file to `.env` and fill it in. `.env` is gitignored; this file is
# committed. Do not put AWS keys here: use your normal aws CLI / SSO config.
# Confirm access with:  aws sts get-caller-identity
# ---------------------------------------------------------------------------

# --- Required: AWS and the appliance ----------------------------------------
AWS_REGION=us-east-1

# Netskope VPE appliance AMI for AI Guardrails on Demand. Netskope shares it with
# your account. Ask your Netskope account team for the ID in your region.
GUARDRAILS_AMI_ID=

# Existing EC2 key pair in AWS_REGION. Used for SSH to the appliance as nsadmin
# during the one-time VPE CLI activation (see the deployment guide).
GUARDRAILS_KEY_NAME=

# --- Required: AI Guardrails profile ----------------------------------------
# Profile ID to evaluate prompts against. From the Netskope UI:
# Security Cloud Platform > Policies > AI Guardrails > Profiles.
AIGD_PROFILE_ID=

# --- Anthropic signing secret -----------------------------------------------
# Leave empty on the first deploy. Anthropic shows the whsec_ value when you
# save the endpoint. Paste it here and rerun ./deploy.ps1.
ANTHROPIC_SIGNING_SECRET=
# Optional. Only while rotating: the previous whsec_ value, accepted until the
# switchover is complete.
ANTHROPIC_SIGNING_SECRET_PREVIOUS=

# --- Naming -----------------------------------------------------------------
# Prefix for the appliance stack's resources (VPC, ALB, ASG, cert parameter).
GUARDRAILS_NAME=netskope-guardrails
# Prefix for the webhook's resources and SSM parameter names.
RESOURCE_PREFIX=anthropic-aigd

# --- Network ----------------------------------------------------------------
# New VPC CIDR (/16 to /22). Must not overlap networks you will peer with.
VPC_CIDR=10.5.0.0/16
# Optional extra CIDR (peered VPC, Transit Gateway, VPN) allowed to reach the
# ALB on 443 and the appliance on SSH 22. Empty = VPC CIDR only.
ADDITIONAL_CLIENT_CIDR=
# Route 53 private zone for the new VPC. Change it if another VPC you connect
# already uses this zone name.
HOSTED_ZONE_NAME=aigw.internal
# Internal FQDN for the Guardrails ALB. Must be inside HOSTED_ZONE_NAME.
GUARDRAILS_DOMAIN_NAME=guardrails.aigw.internal

# --- Appliance sizing -------------------------------------------------------
# m5.2xlarge, m5.4xlarge, m6i.2xlarge or m6i.4xlarge. CPU only.
GUARDRAILS_INSTANCE_TYPE=m5.2xlarge
GUARDRAILS_ROOT_VOLUME_GB=1024
GUARDRAILS_MIN_CAPACITY=1
GUARDRAILS_DESIRED_CAPACITY=1
GUARDRAILS_MAX_CAPACITY=2

# --- Webhook request handling ------------------------------------------------
# Client-side timeout for the AI Guardrails call, in seconds. Keep it below the
# verdict timeout set in Anthropic (default 5000 ms; recommended 8000 ms).
AIGD_TIMEOUT_SECONDS=5
# Lambda timeout in seconds. Must be greater than AIGD_TIMEOUT_SECONDS.
LAMBDA_TIMEOUT_SECONDS=6
LAMBDA_MEMORY_MB=256

# Comma-separated source blocks allowed to call the webhook. Keep Anthropic's
# range. Add a /32 for each test address (for example your own public IP).
ANTHROPIC_SOURCE_CIDRS=160.79.106.0/24

# API Gateway stage. The webhook URL is the stage invoke URL.
API_STAGE_NAME=prod

# --- Optional overrides (defaults in terraform/variables.tf) -----------------
#AIGD_URL=
#THROTTLE_RATE_LIMIT=0
#THROTTLE_BURST_LIMIT=0
#LOG_LEVEL=INFO
#LOG_RETENTION_DAYS=30
# Some accounts require a permissions boundary on Lambda roles. Empty = none.
#PERMISSIONS_BOUNDARY_ARN=

# --- Tags (applied only when set) --------------------------------------------
#TAG_OWNER=
#TAG_PROJECT_TYPE=
#TAG_COST_CENTER=
#TAG_STAGE=
#TAG_SENSITIVITY=

# --- Corporate network ------------------------------------------------------
# Path to a corporate TLS-inspection CA bundle for the AWS CLI. Leave empty if
# not needed.
#CA_BUNDLE=
